# EXAMPLE ONLY — intentionally not an active GitHub Actions workflow.
# Task P0-06: run `firebase init hosting:github` after the Astro app exists to generate the real
# workflow and a correctly scoped secret, review it against this intent, then delete this file.
# Never put credential JSON in the repository.
name: Build & deploy Linkedia (example)
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: deploy-production
  cancel-in-progress: false
jobs:
  test-build-deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
      - run: npm ci
      - run: npm run validate   # content vs. contracts (also runs as prebuild)
      - run: npm test --if-present
      - run: npm run build
      # Deploy step (FirebaseExtended/action-hosting-deploy) is added by `firebase init hosting:github`
      # with channelId: live, only on push to main. Then a smoke step, e.g.:
      # - run: curl -fsS https://<site>.web.app/ > /dev/null
