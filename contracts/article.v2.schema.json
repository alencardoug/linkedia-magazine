{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedia.web.app/contracts/article.v2.schema.json",
  "title": "Public Linkedia Article (v2)",
  "description": "Public contract v2 (Linkedia v2, D-079; IDEA_BOX §2, §4). Technical fields stay strict: ids, slug, dates, title, body blocks, citations, AI disclosure and safe rendering. Editorial fields are optional and unconstrained: summary, prompt_actions (no read_more requirement), reading time without the 30-minute cap, free callout variants. v1 files keep article.schema.json; the validator picks the schema by schema_version. Mirrored from linkedia-studio from V2-07 on (byte-equality check).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "slug",
    "edition_date",
    "published_at",
    "locale",
    "editoria",
    "title",
    "read_minutes",
    "tags",
    "sources",
    "blocks",
    "editorial_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "article_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "edition_date": {
      "type": "string",
      "format": "date"
    },
    "published_at": {
      "description": "When this article's batch was published (export time declared by the engine). Several batches may add articles to one edition.",
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "const": "pt-BR"
    },
    "editoria": {
      "$ref": "#/$defs/editoria"
    },
    "title": {
      "type": "string",
      "minLength": 6,
      "maxLength": 160
    },
    "summary": {
      "description": "Optional; cards and the meta description omit it when absent.",
      "type": "string",
      "minLength": 1
    },
    "read_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "description": "Keys from the public tag catalog. The channel is a separate field and is never repeated as a tag.",
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^(topic|theme|region|risk|reason|source):[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "prompt_actions": {
      "description": "Optional copy-to-clipboard prompts; any kinds, any number.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/prompt_action"
      }
    },
    "editorial_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_version",
        "generated_at",
        "reviewed_sources",
        "ai_generated",
        "supersedes_article_id"
      ],
      "properties": {
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_sources": {
          "description": "True when every cited source was fetched and checked by the engine during the run.",
          "type": "boolean"
        },
        "ai_generated": {
          "description": "Public AI disclosure (D-028).",
          "const": true
        },
        "model": {
          "description": "Model identifier as reported by the CLI, when available. Never a session id.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_ref": {
          "description": "Opaque private run UUID, safe to publish; lets the owner trace provenance.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "supersedes_article_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "string",
      "pattern": "^s[0-9]{1,3}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "url",
        "publisher",
        "accessed_at"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_ref"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "description": "ISO 8601 date or date-time, when known.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    },
    "block": {
      "anyOf": [
        {
          "$ref": "#/$defs/block_paragraph"
        },
        {
          "$ref": "#/$defs/block_heading"
        },
        {
          "$ref": "#/$defs/block_list"
        },
        {
          "$ref": "#/$defs/block_quote"
        },
        {
          "$ref": "#/$defs/block_callout"
        },
        {
          "$ref": "#/$defs/block_code"
        },
        {
          "$ref": "#/$defs/block_diagram"
        },
        {
          "$ref": "#/$defs/block_image"
        }
      ]
    },
    "block_paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "block_heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text",
        "level"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "level": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        }
      }
    },
    "block_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "ordered": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_ids": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "block_quote": {
      "description": "Short attributed quotation; must cite at least one source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text",
        "source_ids"
      ],
      "properties": {
        "type": {
          "const": "quote"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "attribution": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      }
    },
    "block_callout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "callout"
        },
        "variant": {
          "description": "Free variant id; known ids get a pt-BR label in the magazine, others use label or \"Nota\".",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 32
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/source_refs"
        },
        "label": {
          "description": "Optional pt-BR label shown before the text.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      }
    },
    "block_code": {
      "description": "Rendered as escaped text only; never executed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "language",
        "code"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z0-9+#.-]{1,24}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "block_diagram": {
      "description": "MVP renders the spec as escaped text plus long_description (D-027).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "diagram_format",
        "diagram_spec",
        "alt",
        "long_description"
      ],
      "properties": {
        "type": {
          "const": "diagram"
        },
        "diagram_format": {
          "enum": [
            "mermaid",
            "text"
          ]
        },
        "diagram_spec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "long_description": {
          "type": "string",
          "minLength": 20
        },
        "caption": {
          "type": "string"
        },
        "source_ids": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "block_image": {
      "description": "Allowed only for hosts in the engine's image_host_allowlist (D-026).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "image_url",
        "alt",
        "long_description",
        "credit",
        "source_ids"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "long_description": {
          "type": "string",
          "minLength": 20
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      }
    },
    "prompt_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "prompt"
      ],
      "properties": {
        "kind": {
          "description": "Optional free kind id; known ids get a pt-BR label.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "editoria": {
      "enum": [
        "ai_engineering_knowledge",
        "ai_leadership",
        "marketing",
        "health",
        "china",
        "latest_news"
      ]
    }
  }
}
