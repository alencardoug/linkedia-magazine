{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedia.web.app/contracts/theme_manifest.schema.json",
  "title": "Visual Theme Manifest",
  "description": "Owned by this repository (themes/manifest.json) and changed only by weekly visual-lab PRs (D-025). Bootstrap: before the first experiment, current/previous are null and no switcher renders; with a single experiment, previous is null and its slot renders disabled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_theme_id",
    "previous_theme_id",
    "current_theme_id",
    "week_id",
    "themes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "baseline_theme_id": { "const": "minimal-dark" },
    "previous_theme_id": { "anyOf": [{ "$ref": "#/$defs/lab_id" }, { "type": "null" }] },
    "current_theme_id": { "anyOf": [{ "$ref": "#/$defs/lab_id" }, { "type": "null" }] },
    "week_id": { "type": ["string", "null"], "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^(minimal-dark|lab-[0-9]{4}-w[0-9]{2})$" },
          "kind": { "enum": ["baseline", "lab"] },
          "week_id": { "type": ["string", "null"], "pattern": "^[0-9]{4}-W[0-9]{2}$" },
          "title": { "type": "string", "minLength": 2, "maxLength": 60 },
          "status": {
            "description": "active = occupies a slot; archived = past experiment kept in code; disabled = failed a gate.",
            "enum": ["active", "archived", "disabled"]
          },
          "git_ref": { "type": ["string", "null"] },
          "summary": { "type": "string", "maxLength": 300 }
        }
      }
    }
  },
  "$defs": {
    "lab_id": { "type": "string", "pattern": "^lab-[0-9]{4}-w[0-9]{2}$" }
  }
}
