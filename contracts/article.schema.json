{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedia.web.app/contracts/article.schema.json",
  "title": "Public Linkedia Article",
  "description": "Public contract exported by the private engine and rendered by the static magazine. Every field is set by the engine; the LLM produces only contracts/llm/article_output.schema.json. Pre-release: may change without a version bump until the first public publication (D-029).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "slug",
    "edition_date",
    "locale",
    "channel",
    "title",
    "summary",
    "read_minutes",
    "tags",
    "sources",
    "blocks",
    "prompt_actions",
    "editorial_metadata"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "article_id": { "type": "string", "format": "uuid" },
    "slug": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "edition_date": { "type": "string", "format": "date" },
    "locale": { "const": "pt-BR" },
    "channel": { "$ref": "#/$defs/channel" },
    "title": { "type": "string", "minLength": 6, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 400 },
    "read_minutes": { "type": "integer", "minimum": 1, "maximum": 30 },
    "tags": {
      "description": "Keys from the public tag catalog. The channel is a separate field and is never repeated as a tag.",
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^(topic|theme|region|risk|reason|source):[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    },
    "prompt_actions": {
      "description": "Copy-to-clipboard prompts. Exactly one read_more ('Saber mais').",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/prompt_action" },
      "contains": {
        "type": "object",
        "properties": { "kind": { "const": "read_more" } },
        "required": ["kind"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "editorial_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_version",
        "generated_at",
        "reviewed_sources",
        "ai_generated",
        "supersedes_article_id"
      ],
      "properties": {
        "content_version": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "reviewed_sources": {
          "description": "True when every cited source was fetched and checked by the engine during the run.",
          "type": "boolean"
        },
        "ai_generated": {
          "description": "Public AI disclosure (D-028).",
          "const": true
        },
        "model": {
          "description": "Model identifier as reported by the CLI, when available. Never a session id.",
          "type": ["string", "null"]
        },
        "run_ref": {
          "description": "Opaque private run UUID, safe to publish; lets the owner trace provenance.",
          "type": ["string", "null"],
          "format": "uuid"
        },
        "supersedes_article_id": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    }
  },
  "$defs": {
    "channel": { "enum": ["ai_knowledge", "ai_engineering", "ai_leadership"] },
    "source_ref": { "type": "string", "pattern": "^s[0-9]{1,3}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "url", "publisher", "accessed_at"],
      "properties": {
        "source_id": { "$ref": "#/$defs/source_ref" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "type": "string", "minLength": 1 },
        "published_at": {
          "description": "ISO 8601 date or date-time, when known.",
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "accessed_at": { "type": "string", "format": "date-time" },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "attribution": { "type": "string" }
      }
    },
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_ref" }
    },
    "block": {
      "anyOf": [
        { "$ref": "#/$defs/block_paragraph" },
        { "$ref": "#/$defs/block_heading" },
        { "$ref": "#/$defs/block_list" },
        { "$ref": "#/$defs/block_quote" },
        { "$ref": "#/$defs/block_callout" },
        { "$ref": "#/$defs/block_code" },
        { "$ref": "#/$defs/block_diagram" },
        { "$ref": "#/$defs/block_image" }
      ]
    },
    "block_paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/source_refs" }
      }
    },
    "block_heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "level"],
      "properties": {
        "type": { "const": "heading" },
        "text": { "type": "string", "minLength": 1, "maxLength": 160 },
        "level": { "type": "integer", "minimum": 2, "maximum": 4 }
      }
    },
    "block_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_ids": { "$ref": "#/$defs/source_refs" }
      }
    },
    "block_quote": {
      "description": "Short attributed quotation; must cite at least one source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "source_ids"],
      "properties": {
        "type": { "const": "quote" },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "attribution": { "type": "string" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_ref" }
        }
      }
    },
    "block_callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "callout" },
        "variant": { "enum": ["note", "takeaway", "warning", "uncertainty"] },
        "text": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/source_refs" }
      }
    },
    "block_code": {
      "description": "Rendered as escaped text only; never executed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "language", "code"],
      "properties": {
        "type": { "const": "code" },
        "language": { "type": "string", "pattern": "^[a-z0-9+#.-]{1,24}$" },
        "code": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "caption": { "type": "string" }
      }
    },
    "block_diagram": {
      "description": "MVP renders the spec as escaped text plus long_description (D-027).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "diagram_format", "diagram_spec", "alt", "long_description"],
      "properties": {
        "type": { "const": "diagram" },
        "diagram_format": { "enum": ["mermaid", "text"] },
        "diagram_spec": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 250 },
        "long_description": { "type": "string", "minLength": 20 },
        "caption": { "type": "string" },
        "source_ids": { "$ref": "#/$defs/source_refs" }
      }
    },
    "block_image": {
      "description": "Allowed only for hosts in the engine's image_host_allowlist (D-026).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image_url", "alt", "long_description", "credit", "source_ids"],
      "properties": {
        "type": { "const": "image" },
        "image_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 250 },
        "long_description": { "type": "string", "minLength": 20 },
        "credit": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_ref" }
        }
      }
    },
    "prompt_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "prompt"],
      "properties": {
        "kind": { "enum": ["read_more", "lab", "architecture", "critic", "leadership", "other"] },
        "label": { "type": "string", "minLength": 2, "maxLength": 60 },
        "prompt": { "type": "string", "minLength": 20, "maxLength": 2000 }
      }
    }
  }
}
