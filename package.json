    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.30",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
