---
import type { Source } from '../types/contracts';
import { longDate } from '../lib/labels';

interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

<section aria-labelledby="fontes" data-sources>
  <h2 id="fontes">Fontes</h2>
  <ol>
    {
      sources.map((s) => (
        <li id={`fonte-${s.source_id}`}>
          <a href={s.url} rel="noopener noreferrer nofollow">{s.title}</a>
          <span class="meta">
            {' — '}
            {s.publisher}
            {s.published_at && `, ${longDate(s.published_at)}`}
            {s.attribution && ` (${s.attribution})`}
          </span>
        </li>
      ))
    }
  </ol>
</section>
