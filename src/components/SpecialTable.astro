---
// A table on a special page (D-075). Wide columns: a focusable scroll region. Under 34rem each row stacks as a card
// with the column name over each cell; the explicit ARIA roles keep the table semantics that a display change can
// drop in some browsers. A list cell holds codes written as "GOV-01 Name (TEC-01, notes)": the code on its own line,
// the name, then the optional correspondences, each code in them kept unbroken.
interface Props {
  label: string;
  /** Column headers; the first names the row headers. */
  columns: readonly string[];
  /** Each row: its header, then one cell per remaining column. */
  rows: readonly (readonly (string | readonly string[])[])[];
  /** Keep a minimum width (and scroll) instead of squeezing three dense columns. */
  wide?: boolean;
  /** The first column header is read by screen readers only. */
  hideRowHeaderTitle?: boolean;
}
const { label, columns, rows, wide = false, hideRowHeaderTitle = false } = Astro.props;
const parts = (item: string) => {
  const space = item.indexOf(' ');
  const [, name, pair] = /^(.*?)(?: \(([^)]+)\))?$/.exec(item.slice(space + 1)) ?? [];
  return { code: item.slice(0, space), name, pair };
};
---

<div class="gv-table" role="region" aria-label={label} tabindex="0">
  <table role="table" data-wide={wide ? '' : undefined}>
    <thead role="rowgroup">
      <tr role="row">
        {
          columns.map((title, i) => (
            <th scope="col" role="columnheader">
              {i === 0 && hideRowHeaderTitle ? <span class="visually-hidden">{title}</span> : title}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        rows.map(([head, ...cells]) => (
          <tr role="row">
            <th scope="row" role="rowheader">
              {head}
            </th>
            {cells.map((cell, i) => (
              <td role="cell" data-label={columns[i + 1]}>
                {typeof cell === 'string' ? (
                  cell
                ) : (
                  <ul>
                    {cell.map((item) => {
                      const { code, name, pair } = parts(item);
                      return (
                        <li>
                          <code>{code}</code> {name}
                          {pair && (
                            <span class="pair">
                              {' ('}
                              {pair.split(', ').map((piece, k) => (
                                <>
                                  {k > 0 && ', '}
                                  {/^[A-Z]+-\d+$/.test(piece) ? <span class="code">{piece}</span> : piece}
                                </>
                              ))}
                              {')'}
                            </span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .gv-table {
    overflow-x: auto;
    margin: 0 0 var(--space-4);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  table[data-wide] {
    min-width: 36rem;
  }

  th,
  td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  tbody th {
    min-width: 8rem;
  }

  ul {
    min-width: 10rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: var(--space-1);
  }

  code {
    display: block;
    color: var(--accent);
    font-weight: 700;
  }

  .pair {
    color: var(--muted);
  }

  .pair .code {
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
    .gv-table {
      overflow: visible;
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    table[data-wide] {
      min-width: 0;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    tbody tr {
      padding: var(--space-2) 0 var(--space-3);
      border-bottom: 1px solid var(--border);
    }

    th,
    td {
      padding: 0;
      border: 0;
    }

    tbody th {
      min-width: 0;
      margin-bottom: var(--space-1);
      font-size: var(--text-base);
    }

    td + td {
      margin-top: var(--space-2);
    }

    td::before {
      content: attr(data-label);
      display: block;
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    ul {
      min-width: 0;
    }
  }
</style>
