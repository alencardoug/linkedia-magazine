---
// Shared page shell (1B-01). Visual design and tokens come in 1B-02; markup stays semantic and theme-agnostic
// with stable data-* hooks.
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Revista diária sobre engenharia de IA, liderança em IA e conhecimento em IA.' } =
  Astro.props;
const pageTitle = title === 'Linkedia' ? title : `${title} — Linkedia`;
---

<!doctype html>
<html lang="pt-BR" data-theme="minimal-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #111214;
        --fg: #e8e6e3;
        --muted: #a7a39d;
        --accent: #8ab4f8;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, sans-serif;
        line-height: 1.6;
      }
      a {
        color: var(--accent);
      }
      header[data-site-header],
      main,
      footer[data-site-footer] {
        max-width: 42rem;
        margin: 0 auto;
        padding: 1rem;
      }
      pre {
        overflow-x: auto;
      }
      .meta {
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <a href="#conteudo" class="pular">Pular para o conteúdo</a>
    <header data-site-header>
      <nav aria-label="Principal">
        <a href="/" data-brand><strong>Linkedia</strong></a>
        · <a href="/edicoes">Edições</a>
      </nav>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer data-site-footer>
      <p class="meta">
        Textos gerados com IA a partir de fontes citadas, com pautas escolhidas e revisadas por um editor humano.
      </p>
    </footer>
  </body>
</html>
