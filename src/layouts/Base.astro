---
// Shared page shell. Markup is semantic with stable data-* hooks; the look comes from src/styles/site.css, in one
// of three reading modes (V2-06, D-081): the system's light or dark by default, black only when picked. `/modo.js`
// is a classic same-origin script, blocking in <head>, that applies the stored pick before the first paint (no
// inline script, so the CSP needs no hash); the discreet header button (src/lib/mode.ts) cycles light → dark →
// black. Without JS the system mode applies and the button stays hidden. The footer carries the AI note only where
// `aiNote` is set (`/revista`; each article has its own note); the editor is named on `/sobre` only.
// Cover pages (`/`, `/visual/<slug>`) and art-directed specials do not use this shell (CoverPage.astro,
// SpecialLayout.astro): cover art keeps its own palette.
import '../styles/site.css';
import { AI_NOTE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Show the short AI note in the footer (only `/revista`; articles carry their own note). */
  aiNote?: boolean;
}
const {
  title,
  description = 'Revista diária sobre engenharia de IA, liderança em IA e conhecimento em IA.',
  aiNote = false,
} = Astro.props;
const pageTitle = title === 'Linkedia' ? title : `${title} — Linkedia`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <script is:inline src="/modo.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#conteudo" class="pular">Pular para o conteúdo</a>
    <header data-site-header>
      <nav aria-label="Principal">
        <a href="/revista" data-brand><strong>Linkedia</strong></a>
        <a href="/edicoes">Edições</a>
        <a href="/visual">Visual</a>
        <a href="/sobre">Sobre</a>
      </nav>
      <button type="button" data-mode-toggle aria-describedby="modo-proximo" hidden>
        <svg data-mode-icon="light" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
        <svg data-mode-icon="dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg>
        <svg data-mode-icon="black" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle></svg>
        <span class="visually-hidden">Modo de leitura: </span><span data-mode-label>Escuro</span>
      </button>
      <span id="modo-proximo" class="visually-hidden" data-mode-next></span>
      <span class="visually-hidden" aria-live="polite" data-mode-status></span>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    {
      aiNote && (
        <footer data-site-footer>
          <p class="meta">{AI_NOTE} <a href="/sobre">Como a Linkedia é feita</a>.</p>
        </footer>
      )
    }
    <script>
      import { initModeToggle } from '../lib/mode';

      initModeToggle();
    </script>
  </body>
</html>
