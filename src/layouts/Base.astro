---
// Shared page shell. Markup is semantic and theme-agnostic with stable data-* hooks; the look comes from the
// active theme's CSS (baseline `minimal-dark`, 1B-02; lab themes of the manifest's slots, 1C-01). Once a lab
// theme exists, <html> names the three slots, the current one is the default, and a tiny inline script applies
// the reader's stored slot before the first paint (its hash is in the CSP) and ThemeRuntime starts the slot's
// enhancement on every page; the switcher itself lives only on `/visual` (owner, 2026-10-19). The footer carries
// the AI note only where `aiNote` is set (`/revista`; each article has its own note); the editor is named on `/sobre` only.
// Cover pages (`/`, `/visual/<slug>`) do not use this shell: they have their own (CoverPage.astro, 3-01).
import '../../themes/minimal-dark/theme.css';
import 'virtual:linkedia-themes/styles';
import slots from 'virtual:linkedia-themes/slots';
import ThemeRuntime from '../components/ThemeRuntime.astro';
import { AI_NOTE } from '../lib/site';
import { THEME_INIT_SCRIPT } from '../lib/theme-init';

interface Props {
  title: string;
  description?: string;
  /** Show the short AI note in the footer (only `/revista`; articles carry their own note). */
  aiNote?: boolean;
}
const {
  title,
  description = 'Revista diária sobre engenharia de IA, liderança em IA e conhecimento em IA.',
  aiNote = false,
} = Astro.props;
const pageTitle = title === 'Linkedia' ? title : `${title} — Linkedia`;
const lab = slots.current !== null;
---

<!doctype html>
<html
  lang="pt-BR"
  data-theme={slots.current?.id ?? slots.baseline.id}
  data-theme-baseline={lab ? slots.baseline.id : undefined}
  data-theme-previous={slots.previous?.id}
  data-theme-current={slots.current?.id}
>
  <head>
    <meta charset="utf-8" />
    {lab && <script is:inline set:html={THEME_INIT_SCRIPT} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#conteudo" class="pular">Pular para o conteúdo</a>
    <header data-site-header>
      <nav aria-label="Principal">
        <a href="/revista" data-brand><strong>Linkedia</strong></a>
        <a href="/edicoes">Edições</a>
        <a href="/visual">Visual</a>
        <a href="/sobre">Sobre</a>
      </nav>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    {
      aiNote && (
        <footer data-site-footer>
          <p class="meta">{AI_NOTE} <a href="/sobre">Como a Linkedia é feita</a>.</p>
        </footer>
      )
    }
    {lab && <ThemeRuntime />}
  </body>
</html>
