---
const title = 'Linkedia';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="Revista diária sobre engenharia de IA, liderança em IA e conhecimento em IA." />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #111214;
        --fg: #e8e6e3;
        --muted: #a7a39d;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 36rem;
        padding: 2rem 1rem;
      }
      h1 {
        font-size: clamp(2rem, 8vw, 3.5rem);
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
      }
      p {
        color: var(--muted);
        margin: 0;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Revista diária sobre engenharia de IA, liderança em IA e conhecimento em IA. Em construção: nenhuma edição publicada ainda.</p>
    </main>
  </body>
</html>
