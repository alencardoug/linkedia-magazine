---
// `/revista`: the most recent edition (PUBLIC_EXPERIENCE), lead story first; a day without edition shows the last one.
// It was `/` until the cover pre-page took that route (3-01, D-067); the header brand and the 404 page link here.
import Base from '../layouts/Base.astro';
import '../covers/view-transition.css';
import ArticleCard from '../components/ArticleCard.astro';
import { loadContent } from '../lib/content';
import { longDate } from '../lib/labels';

const latest = loadContent().editions[0];
const [lead, ...rest] = latest?.articles ?? [];
---

<Base title="Linkedia">
  {
    latest ? (
      <section aria-labelledby="edicao" data-edition={latest.edition.edition_date}>
        <h1 id="edicao">{latest.edition.title}</h1>
        <p class="meta">
          Edição de <time datetime={latest.edition.edition_date}>{longDate(latest.edition.edition_date)}</time>
        </p>
        {latest.edition.summary && <p>{latest.edition.summary}</p>}
        {lead && <ArticleCard article={lead} lead />}
        {rest.map((a) => <ArticleCard article={a} />)}
        <p>
          <a href="/edicoes">Edições anteriores</a>
        </p>
      </section>
    ) : (
      <section data-empty>
        <h1>Linkedia</h1>
        <p class="meta">
          Revista diária sobre engenharia de IA, liderança em IA e conhecimento em IA. Nenhuma edição publicada ainda.
        </p>
      </section>
    )
  }
</Base>
