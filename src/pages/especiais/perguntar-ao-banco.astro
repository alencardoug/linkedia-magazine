// Words that read as code inside platform text (paths, flags, files, identifiers): set as <code>, escaped.
const CODE = /(\.claude\/skills\/<nome>\/SKILL\.md|\.claude\/settings\.json|~\/\.codex\/config\.toml|\.gemini\/commands\/|~?\/?\.gemini\/settings\.json|bq query --dry_run|codex exec|--output-schema|claude -p|gemini -p|CLAUDE\.md|AGENTS\.md|GEMINI\.md|PreToolUse|TableAnnotations|ColumnAnnotations|CuratedQueries|LIMIT|\bbq\b|snowsql|psql)/;
const parts = (s: string) => s.split(CODE).map((t, i) => ({ t, code: i % 2 === 1 }));

const steps = [
