<SpecialLayout title={page.title} description={page.summary} fonts={[mona, jetbrains]}>
  <article data-article="especial-perguntar-ao-banco" data-special>
    <section class="hero" aria-labelledby="titulo" data-hero>
      <div class="wrap hero-grid">
        <div>
          <p class="kicker mono">Conteúdo especial · NL→SQL</p>
          <h1 id="titulo">{page.title}</h1>
          <p class="dek">
            Um teste com 20 perguntas de negócio no Gemini do BigQuery acertou 25%. O número parece ruim até ser posto ao
            lado dos benchmarks acadêmicos de cenário corporativo, e fica bem longe dos ~90% que os fornecedores anunciam.
            A hipótese mais forte para a diferença tem nome: camada semântica.
          </p>
          <ul class="chips mono">
            <li><Icon name="file-text" />Conteúdo especial</li>
            <li><Icon name="gauge" />{page.readMinutes} min de leitura</li>
            <li><Icon name="flask-conical" />Teste: 5 de 20</li>
          </ul>
        </div>
        <div class="hero-art" aria-hidden="true">
