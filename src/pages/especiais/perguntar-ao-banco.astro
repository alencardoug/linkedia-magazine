                  <path d="M20 30c0-16 12-24 26-24s26 8 26 22c0 18-24 18-24 38M48 92v4" />
                </svg>
                <span class="collar"></span>
              </div>
              <span class="shaft"></span>
              <span class="shaft shaft-b"></span>
            </div>
          </div>
          <span class="tag tag-corp">Pergunta de negócio</span>
          <span class="tag tag-ponte">Camada semântica</span>
          <span class="tag tag-tec">Dados do warehouse</span>
        </div>
        <ul class="art-legend mono" aria-hidden="true">
          <li data-c="corp">Pergunta de negócio</li>
