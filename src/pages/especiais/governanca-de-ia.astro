// own shell, fonts and light/dark choice; text identical to the D-075 guide (src/specials/governanca-de-ia/data.ts and
// the section components). Every diagram reads in order as text without CSS or JS.
import SpecialLayout from '../../layouts/SpecialLayout.astro';
import { special } from '../../lib/specials';
import Part1 from '../../specials/governanca-de-ia/Part1.astro';
import Part2 from '../../specials/governanca-de-ia/Part2.astro';
import Part3 from '../../specials/governanca-de-ia/Part3.astro';
import Part4 from '../../specials/governanca-de-ia/Part4.astro';
import Part5 from '../../specials/governanca-de-ia/Part5.astro';
import Top from '../../specials/governanca-de-ia/Top.astro';
import bricolage from '../../specials/governanca-de-ia/fonts/bricolage-grotesque.woff2?url';
import instrumentSans from '../../specials/governanca-de-ia/fonts/instrument-sans.woff2?url';
import '../../specials/governanca-de-ia/base.css';
import '../../specials/governanca-de-ia/hero.css';
import '../../specials/governanca-de-ia/part1.css';
import '../../specials/governanca-de-ia/part2.css';
import '../../specials/governanca-de-ia/part3.css';
import '../../specials/governanca-de-ia/part4.css';
import '../../specials/governanca-de-ia/part5.css';

const page = special('governanca-de-ia');
---

<SpecialLayout
  title={page.title}
  description={page.summary}
  fonts={[bricolage, instrumentSans]}
  schemeScript="/especiais/governanca-de-ia/esquema.js"
>
  <article data-article="especial-governanca-de-ia" data-special>
    <Top page={page} />
    <Part1 />
    <Part2 />
    <Part3 />
    <Part4 />
    <Part5 />
