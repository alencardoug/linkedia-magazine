---
// `/visual` (was `/capas`; owner, 2026-10-19): the gallery of every weekly cover, newest first (3-01, D-067,
// docs/COVERS.md). The reading-theme switcher that lived here is retired (V2-06, D-081): the reading mode is the
// header button of every page. A reading page: it links to each cover and loads none of their code.
import Base from '../layouts/Base.astro';
import { COVERS, coverPath, CURRENT_COVER, weekLabel } from '../covers/registry';
---

<Base title="Visual" description="O visual da Linkedia: todas as capas, arte interativa feita com IA, uma por semana.">
  <h1>Visual</h1>
  <section aria-labelledby="capas" data-covers>
    <h2 id="capas">Capas</h2>
    <p class="meta">
      Toda semana a Linkedia ganha uma capa nova: arte interativa programada com IA, que roda ao vivo no seu aparelho.
      Clique em qualquer lugar de uma capa para entrar na revista.
    </p>
    <ol data-cover-list>
      {
        COVERS.map((c) => (
          <li data-cover-item={c.slug}>
            <h3>
              <a href={coverPath(c.slug)}>{c.title}</a>
            </h3>
            <p class="meta">
              Capa da {weekLabel(c.weekId)}
              {c.slug === CURRENT_COVER && <> · a capa atual, também em <a href="/">linkedia.web.app</a></>}
            </p>
            <p>{c.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
