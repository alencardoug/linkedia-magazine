---
// `/visual` (was `/capas`; owner, 2026-10-19): the look of the magazine in one place. The reading theme switcher
// (only here, once a lab theme exists; the choice applies on every page) and every weekly cover, newest first
// (3-01, D-067, docs/COVERS.md). A reading page: it links to each cover and loads none of their code.
import slots from 'virtual:linkedia-themes/slots';
import Base from '../layouts/Base.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { COVERS, coverPath, CURRENT_COVER, weekLabel } from '../covers/registry';

const lab = slots.current !== null;
---

<Base title="Visual" description="O visual da Linkedia: o tema de leitura e todas as capas, arte interativa feita com IA, uma por semana.">
  <h1>Visual</h1>
  {
    lab && (
      <section aria-labelledby="tema" data-theme-choice>
        <h2 id="tema">Tema de leitura</h2>
        <p class="meta">Toda semana a Linkedia testa um visual novo. Escolha aqui como ler as páginas; a escolha vale para o site inteiro.</p>
        <ThemeSwitcher />
      </section>
    )
  }
  <section aria-labelledby="capas" data-covers>
    <h2 id="capas">Capas</h2>
    <p class="meta">
      Toda semana a Linkedia ganha uma capa nova: arte interativa programada com IA, que roda ao vivo no seu aparelho.
      Clique em qualquer lugar de uma capa para entrar na revista.
    </p>
    <ol data-cover-list>
      {
        COVERS.map((c) => (
          <li data-cover-item={c.slug}>
            <h3>
              <a href={coverPath(c.slug)}>{c.title}</a>
            </h3>
            <p class="meta">
              Capa da {weekLabel(c.weekId)}
              {c.slug === CURRENT_COVER && <> · a capa atual, também em <a href="/">linkedia.web.app</a></>}
            </p>
            <p>{c.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
