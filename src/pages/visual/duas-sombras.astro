---
// `/visual/duas-sombras`: the 2026-W43 cover, reachable for good (docs/COVERS.md). One page per cover, so each page
// ships only its own cover's CSS and JS.
import CoverPage from '../../layouts/CoverPage.astro';
import Cover from '../../covers/duas-sombras/Cover.astro';
import { coverBySlug, coverEdition } from '../../covers/registry';
import { loadContent } from '../../lib/content';

const cover = coverBySlug('duas-sombras');
---

<CoverPage cover={cover} title={`Capa “${cover.title}” — Linkedia`} description={cover.summary}>
  <Cover latest={coverEdition(cover, loadContent().editions)} />
</CoverPage>
